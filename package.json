{
  "name": "draw-me-database",
  "displayName": "DrawMeDatabase",
  "publisher": "GuillaumeCancalon",
  "description": "A VSCode extension that allows you to visualize a schematic of your database based on your code",
  "version": "1.1.0",
  "icon": "images/logo_128.png", 
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuillaumeCAN/DrawMeDatabase"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["*"],
  "main": "./extension.js",

  "contributes": {
    "commands": [
      {
        "command": "DMDB.draw",
        "title": "DrawMeDatabase"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DrawMeDatabase",
      "properties": {
        "DrawMeDatabase.frameworkPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Relative path to the framework folder **(leave empty if the framework is at the root of the workspace)** \n\n Example : **`my-project/app/symfony`**"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.16.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
