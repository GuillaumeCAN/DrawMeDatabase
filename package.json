{
  "name": "draw-me-database",
  "displayName": "DrawMeDatabase",
  "publisher": "GuillaumeCancalon",
  "description": "A VSCode extension that allows you to visualize a schematic of your database based on your code",
  "version": "1.2.0",
  "icon": "images/logo_128.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuillaumeCAN/DrawMeDatabase"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:drawMeDatabase"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "DMDB.parseSchema",
        "title": "Draw Database Schema",
        "category": "DrawMeDatabase",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "DMDB.refresh",
        "title": "Refresh Diagram",
        "category": "DrawMeDatabase",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DrawMeDatabase",
      "properties": {
        "DrawMeDatabase.frameworkPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Relative path to the framework folder **(leave empty if the framework is at the root of the workspace)** \n\n Example : **`my-project/app/symfony`**"
        },
        "DrawMeDatabase.layout": {
          "type": "string",
          "enum": [
            "elk",
            "dagre"
          ],
          "enumDescriptions": [
            "ELK: compact layout with straight, right-angled links (best for large schemas)",
            "Dagre: the classic Mermaid layout with curved links"
          ],
          "default": "elk",
          "markdownDescription": "How the tables of the diagram are placed. Also available in the toolbar of the diagram."
        },
        "DrawMeDatabase.direction": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "enumDescriptions": [
            "Top to bottom",
            "Left to right"
          ],
          "default": "TB",
          "markdownDescription": "Direction of the diagram, from the referenced tables to the tables that reference them. Also available in the toolbar of the diagram."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "DMDB.refresh",
          "when": "activeWebviewPanelId == 'drawMeDatabase'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "vscode:prepublish": "node scripts/copy-vendor.js --strict",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "pretest": "npm run lint && npm run test:unit",
    "test": "vscode-test",
    "package": "vsce package --out builds/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "~1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mermaid": "12.2.0",
    "ovsx": "^1.3.0"
  }
}
