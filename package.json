{
  "name": "draw-me-database",
  "displayName": "DrawMeDatabase",
  "publisher": "GuillaumeCancalon",
  "description": "A VSCode extension that allows you to visualize a schematic of your database based on your code",
  "version": "1.6.0",
  "icon": "images/logo_128.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GuillaumeCAN/DrawMeDatabase"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:drawMeDatabase"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "DMDB.parseSchema",
        "title": "%command.parseSchema%",
        "category": "DrawMeDatabase",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "DMDB.refresh",
        "title": "%command.refresh%",
        "category": "DrawMeDatabase",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DrawMeDatabase",
      "properties": {
        "DrawMeDatabase.frameworkPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "%setting.frameworkPath%",
          "order": 0
        },
        "DrawMeDatabase.autoRefresh": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.autoRefresh%",
          "order": 1
        },
        "DrawMeDatabase.showGitStatus": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.showGitStatus%",
          "order": 2
        },
        "DrawMeDatabase.layout": {
          "type": "string",
          "enum": [
            "elk",
            "dagre"
          ],
          "enumDescriptions": [
            "%setting.layout.elk%",
            "%setting.layout.dagre%"
          ],
          "default": "elk",
          "markdownDescription": "%setting.layout%",
          "order": 3
        },
        "DrawMeDatabase.direction": {
          "type": "string",
          "enum": [
            "TB",
            "LR"
          ],
          "enumDescriptions": [
            "%setting.direction.TB%",
            "%setting.direction.LR%"
          ],
          "default": "TB",
          "markdownDescription": "%setting.direction%",
          "order": 4
        },
        "DrawMeDatabase.keysOnly": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.keysOnly%",
          "order": 5
        },
        "DrawMeDatabase.relationLabels": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.relationLabels%",
          "order": 6
        },
        "DrawMeDatabase.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "fr"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%setting.language.auto%",
            "English",
            "Français"
          ],
          "markdownDescription": "%setting.language%",
          "order": 7
        },
        "DrawMeDatabase.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%setting.theme.auto%",
            "%setting.theme.light%",
            "%setting.theme.dark%"
          ],
          "markdownDescription": "%setting.theme%",
          "order": 8
        },
        "DrawMeDatabase.palette": {
          "type": "string",
          "enum": [
            "vscode",
            "ocean",
            "forest",
            "sunset",
            "violet",
            "graphite",
            "paper"
          ],
          "default": "vscode",
          "markdownDescription": "%setting.palette%",
          "order": 9
        },
        "DrawMeDatabase.colors": {
          "type": "object",
          "default": {},
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "header": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "line": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "gitNew": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "gitModified": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "gitUnsaved": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "additionalProperties": false,
          "markdownDescription": "%setting.colors%",
          "order": 10
        },
        "DrawMeDatabase.font": {
          "type": "string",
          "enum": [
            "default",
            "editor",
            "sans",
            "serif",
            "mono",
            "custom"
          ],
          "default": "default",
          "enumDescriptions": [
            "%setting.font.default%",
            "%setting.font.editor%",
            "%setting.font.sans%",
            "%setting.font.serif%",
            "%setting.font.mono%",
            "%setting.font.custom%"
          ],
          "markdownDescription": "%setting.font%",
          "order": 11
        },
        "DrawMeDatabase.customFont": {
          "type": "string",
          "default": "",
          "markdownDescription": "%setting.customFont%",
          "order": 12
        },
        "DrawMeDatabase.fontSize": {
          "type": "integer",
          "minimum": 10,
          "maximum": 20,
          "default": 13,
          "markdownDescription": "%setting.fontSize%",
          "order": 13
        },
        "DrawMeDatabase.grid": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.grid%",
          "order": 14
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "DMDB.refresh",
          "when": "activeWebviewPanelId == 'drawMeDatabase'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "vscode:prepublish": "node scripts/copy-vendor.js --strict",
    "lint": "eslint .",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "pretest": "npm run lint && npm run test:unit",
    "test": "vscode-test",
    "package": "vsce package --out builds/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "~1.96.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "mermaid": "12.2.0",
    "ovsx": "^1.3.0"
  }
}
